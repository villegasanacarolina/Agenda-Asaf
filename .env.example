# ─────────────────────────────────────────────────────────────
#  CREDENCIALES DE GOOGLE (obligatorias)
# ─────────────────────────────────────────────────────────────
# Correo de la cuenta de servicio (campo "client_email" del JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=agenda-web@tu-proyecto.iam.gserviceaccount.com

# Llave privada (campo "private_key" del JSON). Pégala completa,
# incluyendo -----BEGIN PRIVATE KEY----- y -----END PRIVATE KEY-----
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID del calendario del licenciado (para su calendario principal es su correo de Gmail)
GOOGLE_CALENDAR_ID=correo.del.licenciado@gmail.com

# (Opcional) Otros calendarios suyos que también deben bloquear horarios,
# separados por comas. La cuenta de servicio debe tener acceso a ellos.
BUSY_CALENDAR_IDS=

# ─────────────────────────────────────────────────────────────
#  HORARIO DE ATENCIÓN (opcionales, estos son los valores por defecto)
# ─────────────────────────────────────────────────────────────
TIMEZONE=America/Mexico_City
# Hora de inicio y fin de atención (formato 24 h)
WORK_START=09:00
WORK_END=18:00
# Días de atención: 0=domingo, 1=lunes ... 6=sábado
WORK_DAYS=1,2,3,4,5
# Cuántos días hacia adelante se puede agendar
DAYS_AHEAD=30
# Anticipación mínima para agendar (en minutos)
MIN_NOTICE_MINUTES=120

# ─────────────────────────────────────────────────────────────
#  MODO DEMO (solo para probar el diseño sin Google; NO usar en producción)
# ─────────────────────────────────────────────────────────────
DEMO_MODE=false
